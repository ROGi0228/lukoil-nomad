# === Общие ===
ENVIRONMENT=local          # local | staging | production
DEBUG=true

# === Telegram ===
BOT_TOKEN=000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=123456789,987654321
NEWS_CHANNEL_URL=https://t.me/example_channel
# Username канала для обязательной проверки подписки (getChatMember) — бот должен
# быть в нём администратором. Без @ работать не будет, формат обязателен: @username
REQUIRED_CHANNEL_USERNAME=@example_channel
INSTAGRAM_URL=https://www.instagram.com/example/

# === База данных ===
# POSTGRES_USER/PASSWORD/DB используются docker-compose (подстановка ${VAR}) для
# самого контейнера Postgres — держите их в согласии с DATABASE_URL ниже.
# На проде обязательно задать свой POSTGRES_PASSWORD, дефолт "nomad" — только для локальной разработки.
POSTGRES_USER=nomad
POSTGRES_PASSWORD=nomad
POSTGRES_DB=nomad_lukoil
DATABASE_URL=postgresql+asyncpg://nomad:nomad@localhost:5432/nomad_lukoil

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Объектное хранилище (S3-совместимое, MinIO локально) ===
# MINIO_ROOT_USER/PASSWORD — креды самого контейнера MinIO; S3_ACCESS_KEY/SECRET_KEY —
# то, чем приложение к нему подключается. На проде должны совпадать и быть не дефолтными.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
# Публичный endpoint для presigned-ссылок, которые открывает браузер (вне Docker-сети,
# "minio" не резолвится). Локально — localhost:9000. На проде — https://s3.<домен>
# (Caddy проксирует на minio:9000 с HTTPS, см. docker-compose.prod.yml/Caddyfile).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nomad-lukoil-media
S3_REGION=us-east-1

# === OCR ===
OCR_PRIMARY_PROVIDER=google_vision      # google_vision | yandex_vision
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_vision_credentials.json
YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=

# === Наблюдаемость ===
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# === Админ-панель ===
# Секрет для подписи сессионных кук — сгенерировать случайную строку, не использовать это значение
ADMIN_PANEL_SECRET_KEY=change-me-to-a-random-secret
